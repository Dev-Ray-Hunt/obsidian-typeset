{
	"name": "obsidian-typeset",
	"version": "0.1.0",
	"description": "An Obsidian plugin that exports notes to polished, print-ready PDFs using CSS-powered layout control.",
	"main": "main.js",
	"author": "Brandon Hunt",
	"license": "MIT",

	"scripts": {
		"dev":           "node esbuild.config.mjs",
		"build":         "node esbuild.config.mjs production",
		"typecheck":     "tsc --noEmit",
		"lint":          "eslint src/",
		"lint:fix":      "eslint src/ --fix",
		"format":        "prettier --write src/ styles/",
		"format:check":  "prettier --check src/ styles/"
	},

	"devDependencies": {
		"@types/node":      "^22.0.0",
		"builtin-modules":  "^4.0.0",
		"esbuild":          "^0.24.0",
		"eslint":           "^9.0.0",
		"obsidian":         "latest",
		"prettier":         "^3.0.0",
		"tslib":            "^2.6.0",
		"typescript":       "^5.6.0",
		"typescript-eslint":"^8.0.0"
	}
}
